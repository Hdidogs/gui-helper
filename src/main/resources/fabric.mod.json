{
	"schemaVersion": 1,
	"id": "gui-helper",
	"version": "${version}",
	"name": "Gui Helper",
	"description": "A framework for building Minecraft GUIs from a single Gui object holding every object and its data.",
	"authors": [
		"Hdido"
	],
	"license": "CC0-1.0",
	"icon": "assets/gui-helper/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fr.hdi.gui.GuiHelper"
		],
		"client": [
			"fr.hdi.gui.client.GuiHelperClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.6",
		"java": ">=21",
		"fabric-api": "*"
